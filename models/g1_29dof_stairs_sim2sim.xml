<mujoco model="g1_29dof parkour stairs scene">
  <include file="g1_29dof.xml"/>

  <statistic center="1.5 0 0.6" extent="4.0"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="stair_mat" rgba="0.45 0.42 0.38 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="8 4 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.0001"/>

    <!-- 20 cm riser, 30 cm tread. MuJoCo box sizes are half extents. -->
    <geom name="approach_platform" type="box" pos="0.65 0 -0.03" size="0.9 2.0 0.03" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_01" type="box" pos="1.70 0 0.10" size="0.15 2.0 0.10" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_02" type="box" pos="2.00 0 0.20" size="0.15 2.0 0.20" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_03" type="box" pos="2.30 0 0.30" size="0.15 2.0 0.30" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_04" type="box" pos="2.60 0 0.40" size="0.15 2.0 0.40" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_05" type="box" pos="2.90 0 0.50" size="0.15 2.0 0.50" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="stair_06" type="box" pos="3.20 0 0.60" size="0.15 2.0 0.60" material="stair_mat" friction="1.0 0.005 0.0001"/>
    <geom name="top_platform" type="box" pos="4.20 0 0.60" size="0.85 2.0 0.60" material="stair_mat" friction="1.0 0.005 0.0001"/>
  </worldbody>
</mujoco>
