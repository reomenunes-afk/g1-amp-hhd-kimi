<mujoco model="g1_29dof flat ground AMP sim2sim scene">
  <!-- g1_29dof_amp.xml = g1_29dof.xml with the three waist joint axes negated.
       The original MJCF inverts the waist chain (torso root) without negating axes,
       so its waist rotates opposite to the training URDF (verified numerically).
       The negated axes restore consistency with the training URDF and the real robot. -->
  <include file="g1_29dof_amp.xml"/>

  <statistic center="0 0 0.5" extent="4.0"/>

  <!-- 500Hz physics, matches the original scene; policy divider 5 -> 100Hz -->
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <!-- flat checker ground only; the AMP policy was trained on flat terrain.
         The original stairs scene (g1_29dof_stairs_sim2sim.xml) is kept unchanged. -->
    <geom name="floor" size="8 8 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.0001"/>
  </worldbody>
</mujoco>
