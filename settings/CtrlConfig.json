    // HumanoidGym AMP v153 (actor projected-gravity): input obs[batch,1470] = 15 frames x 98
    // (oldest->newest), output actions[batch,29]. See HumanoidGymAmpInferenceWorker.hpp.
    "WalkNet1": {
      "Inference": {
        "WarmUpModel": false,
        "IntraNumberThreads": 1
      },
      "Network": {
        // path is resolved against the process working directory; run from build/bin
        "ModelPath": "../../CheckPoints/amp_v153_projected_gravity_model_2500.onnx",
        "InputNodeNames": [
          "obs"
        ],
        "OutputNodeNames": [
          "actions"
        ],
        "Cycle_time": 0.64, // gait cycle time in seconds (training cycle_time)
        "PolicyDt": 0.01 // policy period in seconds (100Hz = 500Hz bus / AmpPolicyFrequency 5)
      },
      "Preprocess": {
        // IMU is in the torso; training base body is the pelvis. Compensate with the
        // waist joint chain (encoders), identical code path on sim and real robot.
        "WaistCompensation": true,
        "ObservationScales": {
          "lin_vel": 0.0, // unused by the AMP observation layout
          "ang_vel": 1.0,
          "project_gravity": 1.0,
          "dof_pos": 1.0,
          "dof_vel": 0.05
        },
        "ClipObservations": 18.0
      },
      "Postprocess": {
        "clip_actions": 18.0,
        // action_scale = 0.25 * URDF_effort / Kp per joint (device order)
        "action_scale": [
          0.22, 0.3475, 0.22, 0.2316666666666667, 0.21875, 0.21875,
          0.22, 0.3475, 0.22, 0.2316666666666667, 0.21875, 0.21875,
          0.11, 0.21875, 0.21875,
          0.15625, 0.15625, 0.15625, 0.15625, 0.15625, 0.03125, 0.03125,
          0.15625, 0.15625, 0.15625, 0.15625, 0.15625, 0.03125, 0.03125
        ],
        // URDF position limits in device order (deployment-side protection;
        // training does not clip q_target)
        "joint_clip_upper": [
          2.8798, 2.9671, 2.7576, 2.8798, 0.5236, 0.2618,
          2.8798, 0.5236, 2.7576, 2.8798, 0.5236, 0.2618,
          2.618, 0.52, 0.52,
          2.6704, 2.2515, 2.618, 2.0944, 1.97222, 1.61443, 1.61443,
          2.6704, 1.5882, 2.618, 2.0944, 1.97222, 1.61443, 1.61443
        ],
        "joint_clip_lower": [
